# Build outputs and toolchain caches (never committed).
.gradle/
build/
*/build/
.gradle-user/
local.properties
*.iml
.idea/

# Android packaging intermediates
*.apk.idsig
android/build/
android/libs/

# Python tooling
__pycache__/
*.pyc
.venv/
venv/

# Raw data acquisitions stay outside Git; only manifests/checksums/compiled bundles are tracked.
data/raw/
tools/.cache/

# Local QA scratch
artifacts/local/

# APK binaries travel through Actions artifacts / Releases, never through Git.
artifacts/*.apk
artifacts/*.apk.sha256
